#include <stdio.h>

int main() {
    char str[200];
    int i = 0;

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0') {

        // Ignore spaces, tabs and new lines
        if (str[i] == ' ' || str[i] == '\t' || str[i] == '\n') {
            i++;
        }

        else if (str[i] == '/' && str[i + 1] == '/') {
            break;
        }

        else if (str[i] == '/' && str[i + 1] == '*') {
            i += 2;

            while (str[i] != '\0' &&
                  !(str[i] == '*' && str[i + 1] == '/')) {
                i++;
            }

            if (str[i] != '\0')
                i += 2;
        }

        else {
            printf("%c", str[i]);
            i++;
        }
    }

    return 0;
}
