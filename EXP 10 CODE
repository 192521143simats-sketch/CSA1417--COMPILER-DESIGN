
#include <stdio.h>
#include <string.h>

int main() {
    char p1[] = "iEtS";
    char p2[] = "iEtSeS";
    char p3[] = "a";

    int i = 0;

    /* Find the common prefix */
    while (p1[i] != '\0' && p2[i] != '\0' &&
           p1[i] == p2[i]) {
        i++;
    }

    printf("Grammar after eliminating left factoring:\n");

    /* Print common prefix followed by a new non-terminal */
    printf("S  -> ");
    for (int j = 0; j < i; j++)
        printf("%c", p1[j]);

    printf(" S' | %s\n", p3);

    /* Print the remaining suffixes */
    printf("S' -> ");
    if (p1[i] == '\0')
        printf("epsilon");
    else
        printf("%s", p1 + i);

    printf(" | ");

    if (p2[i] == '\0')
        printf("epsilon");
    else
        printf("%s", p2 + i);

    printf("\nE  -> b\n");

    return 0;
}
