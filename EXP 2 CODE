#include <stdio.h>
#include <string.h>

int main() {
    char str[200];

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    if (str[0] == '/' && str[1] == '/') {
        printf("It is a single-line comment");
    }
    else if (str[0] == '/' && str[1] == '*' &&
             strstr(str, "*/") != NULL) {
        printf("It is a multi-line comment");
    }
    else {
        printf("It is not a comment");
    }

    return 0;
}
